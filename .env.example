# Frontend (public)
# Supabase: проект → Settings → API (URL и anon key). Сборка (GitHub Pages: Actions secrets) — любые имена:
#   SUPABASE_URL, SUPABASE_ANON_KEY, FUNCTIONS_BASE_URL
# или
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_FUNCTIONS_BASE_URL
SUPABASE_URL=
SUPABASE_ANON_KEY=
FUNCTIONS_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Example: https://xxxxx.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_BASE_URL=
VITE_TELEGRAM_BOT_USERNAME=
# Сборник практик: сумма в копейках (5 ₽ = 500, 4 990 ₽ = 499000).
# Меняется в Supabase → Edge Functions → Secrets без redeploy.
PRACTICES_AMOUNT_KOPECKS=499000
# Сборник практик: tochka | tbank (payment-init)
# VITE_PAYMENT_PROVIDER=tochka
# Опционально: фиксировать цену на сборке сайта (иначе подтягивается /practices-config)
# VITE_PRACTICES_AMOUNT_KOPECKS=499000
# Ссылка на первое сообщение в канале (подсказка после входа)
# VITE_PRACTICES_CHANNEL_POST_URL=https://t.me/c/3454870164/40
# VITE_SITE_URL=https://your-domain.ru

# Supabase Edge Function secrets (set in Dashboard -> Edge Functions -> Secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Закрытый канал сборника (t.me/c/3454870164 → -1003454870164). Бот — админ с правом invite.
TELEGRAM_PRACTICES_CHANNEL_ID=-1003454870164
PUBLIC_SITE_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WELCOME_PHOTO_URL=
TELEGRAM_WELCOME_PHOTO_FILE_ID=
TELEGRAM_WELCOME_PHOTO_URL_DIAGNOSTIC=
TELEGRAM_WELCOME_PHOTO_URL_PRESENT=
TELEGRAM_WELCOME_PHOTO_URL_RAZBOR=
TBANK_RECEIPT_TAXATION=
TBANK_RECEIPT_ITEM_TAX=
TBANK_RECEIPT_EMAIL=
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Optional override for T-Bank callback URL base (Supabase secrets)
# Example: https://vvkjfaxlzlmeobgitxdj.supabase.co/functions/v1
FUNCTIONS_BASE_URL=
